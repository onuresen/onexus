<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
  ONEXUS Revit Addin Manifest
  ───────────────────────────
  INSTRUCTIONS
  1. Copy this file to one of Revit's addin folders:
       All users : C:\ProgramData\Autodesk\Revit\Addins\<version>\
       This user : %APPDATA%\Autodesk\Revit\Addins\<version>\
  2. Update the <Assembly> path to match your built DLL location.
  3. The ClientId GUIDs must stay in sync with OnexusDockablePane.cs (PaneId).
-->
<RevitAddIns>

  <!--
    IExternalApplication: registers the dockable pane and builds the ribbon.
    This MUST load before the IExternalCommand entries.
  -->
  <ExternalApplication>
    <Name>ONEXUS</Name>
    <Assembly>C:\path\to\your\ONES.dll</Assembly>
    <FullClassName>ONES.OnexusApplication</FullClassName>
    <ClientId>C1A2B3D4-E5F6-7890-ABCD-EF1234567890</ClientId>
    <VendorId>ONES</VendorId>
    <VendorDescription>Onur Esen — ONEXUS</VendorDescription>
  </ExternalApplication>

  <!-- Spatial graph (rooms + elements + levels) -->
  <ExternalCommand>
    <Name>ONEXUS — Sync Spaces</Name>
    <Assembly>C:\path\to\your\ONES.dll</Assembly>
    <FullClassName>ONES.Onexus</FullClassName>
    <ClientId>A1000001-0000-0000-0000-000000000001</ClientId>
    <VendorId>ONES</VendorId>
    <VendorDescription>Onur Esen — ONEXUS</VendorDescription>
  </ExternalCommand>

  <!-- Door type hierarchy -->
  <ExternalCommand>
    <Name>ONEXUS — Door Types</Name>
    <Assembly>C:\path\to\your\ONES.dll</Assembly>
    <FullClassName>ONES.OnexusDoors</FullClassName>
    <ClientId>A1000001-0000-0000-0000-000000000002</ClientId>
    <VendorId>ONES</VendorId>
    <VendorDescription>Onur Esen — ONEXUS</VendorDescription>
  </ExternalCommand>

  <!-- Master key / access device graph -->
  <ExternalCommand>
    <Name>ONEXUS — Master Key</Name>
    <Assembly>C:\path\to\your\ONES.dll</Assembly>
    <FullClassName>ONES.OnexusMasterKey</FullClassName>
    <ClientId>A1000001-0000-0000-0000-000000000003</ClientId>
    <VendorId>ONES</VendorId>
    <VendorDescription>Onur Esen — ONEXUS</VendorDescription>
  </ExternalCommand>

  <!-- Parameter binding graph -->
  <ExternalCommand>
    <Name>ONEXUS — Parameters</Name>
    <Assembly>C:\path\to\your\ONES.dll</Assembly>
    <FullClassName>ONES.OnexusParameters</FullClassName>
    <ClientId>A1000001-0000-0000-0000-000000000004</ClientId>
    <VendorId>ONES</VendorId>
    <VendorDescription>Onur Esen — ONEXUS</VendorDescription>
  </ExternalCommand>

  <!-- Toggle docked panel -->
  <ExternalCommand>
    <Name>ONEXUS — Toggle Panel</Name>
    <Assembly>C:\path\to\your\ONES.dll</Assembly>
    <FullClassName>ONES.OnexusTogglePanel</FullClassName>
    <ClientId>A1000001-0000-0000-0000-000000000005</ClientId>
    <VendorId>ONES</VendorId>
    <VendorDescription>Onur Esen — ONEXUS</VendorDescription>
  </ExternalCommand>

  <!-- Set Onexus folder -->
  <ExternalCommand>
    <Name>ONEXUS — Set Folder</Name>
    <Assembly>C:\path\to\your\ONES.dll</Assembly>
    <FullClassName>ONES.OnexusSetFolder</FullClassName>
    <ClientId>A1000001-0000-0000-0000-000000000006</ClientId>
    <VendorId>ONES</VendorId>
    <VendorDescription>Onur Esen — ONEXUS</VendorDescription>
  </ExternalCommand>

  <!-- MEP systems graph (Phase 3) -->
  <ExternalCommand>
    <Name>ONEXUS — MEP Systems</Name>
    <Assembly>C:\path\to\your\ONES.dll</Assembly>
    <FullClassName>ONES.OnexusMEP</FullClassName>
    <ClientId>A1000001-0000-0000-0000-000000000007</ClientId>
    <VendorId>ONES</VendorId>
    <VendorDescription>Onur Esen — ONEXUS</VendorDescription>
  </ExternalCommand>

  <!-- Sheets & views graph (Phase 4) -->
  <ExternalCommand>
    <Name>ONEXUS — Sheets &amp; Views</Name>
    <Assembly>C:\path\to\your\ONES.dll</Assembly>
    <FullClassName>ONES.OnexusSheets</FullClassName>
    <ClientId>A1000001-0000-0000-0000-000000000008</ClientId>
    <VendorId>ONES</VendorId>
    <VendorDescription>Onur Esen — ONEXUS</VendorDescription>
  </ExternalCommand>

</RevitAddIns>
