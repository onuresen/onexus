<UserControl
    x:Class="Onexus.OnexusPaneContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">

    <!--
        The WebView2 fills the entire pane.
        A PlaceholderText block is shown instead when WebView2 cannot initialise
        (e.g. Onexus folder not configured, index.html missing, WebView2 runtime absent).
    -->
    <Grid Background="#1e1e2e">

        <!--  Main browser  -->
        <wv2:WebView2 x:Name="Web" />

        <!--  Error / placeholder overlay  -->
        <TextBlock
            x:Name="PlaceholderText"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="Segoe UI"
            FontSize="13"
            Foreground="#888888"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

    </Grid>
</UserControl>
